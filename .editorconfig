root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sh]
end_of_line = lf

[*.cs]
# Namespaces / usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# var / expression preferences
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_prefer_braces = true:warning

# Naming: private fields are camelCase (accessed via `this.`, per StyleCop)
dotnet_naming_rule.private_fields_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_camel_case.style = camel_case
dotnet_naming_rule.private_fields_camel_case.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case.capitalization = camel_case

# Code-style rules flagged in build (EnforceCodeStyleInBuild)
dotnet_diagnostic.IDE0005.severity = warning # unnecessary using
dotnet_diagnostic.IDE0161.severity = warning # file-scoped namespace

# StyleCop: relax rules that are noise for this project
dotnet_diagnostic.SA1633.severity = none # file header
dotnet_diagnostic.SA1200.severity = none # usings inside namespace (we use outside)
dotnet_diagnostic.SA1101.severity = warning # prefix local calls with this.

[tests/**.cs]
# Test classes/methods don't need XML docs, and test names use underscores.
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none
